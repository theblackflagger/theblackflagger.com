---
// Blog post — /blog/<slug>. getStaticPaths generates one route per non-draft post
// (drafts never get a route). Under build.format:"file" this renders
// /blog/<slug>.html, served at /blog/<slug>. Body renders through the shared
// .prose-app primitive, same as docs. The post title below is the page <h1>, so
// post bodies should lead with prose (no top-level `# Heading`) to avoid two h1s.
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import AppLayout from "../../layouts/AppLayout.astro";
import TagList from "../../components/blog/TagList.astro";

export const getStaticPaths = (async () => {
	const posts = await getCollection("blog");
	return posts
		.filter((post) => !post.data.draft)
		.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage } = post.data;
const dateLabel = pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

const { Content } = await render(post);
---

<AppLayout title={`${title} — The Black Flagger`} description={description}>
	<article class="mx-auto max-w-2xl">
		<a
			href="/blog"
			class="text-sm text-text-secondary underline decoration-border underline-offset-4 transition-colors hover:text-text hover:decoration-text"
		>
			← Blog
		</a>

		<header class="mt-6" data-reveal>
			<time datetime={pubDate.toISOString()} class="text-sm text-text-tertiary">
				{dateLabel}
			</time>
			<h1
				class="mt-3 text-4xl font-semibold tracking-tight text-text sm:text-5xl"
			>
				{title}
			</h1>
			{tags.length > 0 && <div class="mt-4"><TagList tags={tags} /></div>}
			{
				heroImage && (
					<img
						src={heroImage}
						alt=""
						class="mt-8 w-full rounded-2xl border border-border"
					/>
				)
			}
		</header>

		<div class="prose-app mt-10" data-reveal>
			<Content />
		</div>
	</article>
</AppLayout>
