---
// Home / landing page — single-screen hero (logo · tagline · contact).
// Renders through Tailwind + shared tokens like every other page. The ambient
// sunrise lives in the shared <Sunrise> (BaseLayout); text entrance is the
// shared GSAP reveal (elements tagged data-reveal). This page's only custom CSS
// is the `.hero-tagline` gradient.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";
---

<BaseLayout
	title="The Black Flagger — Once a pirate, forever a pirate"
	description="Well-crafted Mac apps — like BlackFlare for Claude Code and Codex. Pirates don't fight for medals, they fight for freedom!"
>
	<div class="flex min-h-screen flex-col">
		<Header />

		<main
			class="flex flex-1 flex-col items-center justify-center px-5 pb-16 text-center"
		>
			<p class="hero-tagline max-w-3xl" data-reveal>
				Pirates don't fight for medals,<br />they fight for freedom!
			</p>

			<div
				class="mt-12 flex flex-wrap items-center justify-center gap-3"
				data-reveal
			>
				<a
					href="https://github.com/theblackflagger"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm text-text-secondary transition duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] btn-vibrancy"
				>
					<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
						<path
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path>
					</svg>@theblackflagger
				</a>
				<a
					href="https://x.com/blackflaggerdev"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm text-text-secondary transition duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] btn-vibrancy"
				>
					<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
						<path
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>@blackflaggerdev
				</a>
				<a
					id="secure-contact"
					href="#"
					aria-label="Send email"
					class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm text-text-secondary transition duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] btn-vibrancy"
				>
					<svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
						<path
							d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
						></path>
					</svg>
					<span id="secure-text">loading...</span>
				</a>
			</div>
		</main>

		<Footer />
	</div>

	<script>
		import "../scripts/email-obfuscation.js";
	</script>
</BaseLayout>

<style>
	/* Hero statement — SF Pro Display (large optical size kicks in automatically
	   at this scale). Semibold + tight negative tracking is the Apple headline
	   recipe. A single vertical gradient runs across both lines — dim at the top,
	   bright white at the bottom — so the emphasis rises toward "freedom!". The
	   line break is forced with <br>. (Dropped the old font-stretch:expanded —
	   SF Pro doesn't honor font-stretch reliably in browsers, so it rendered
	   thin/off.) */
	.hero-tagline {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: clamp(1.9rem, 5vw, 3.25rem);
		line-height: 1.14;
		letter-spacing: -0.022em;
		background-image: linear-gradient(180deg, #8c8c8c 0%, #e2e2e2 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
</style>
