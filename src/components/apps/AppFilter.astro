---
// Client-side filter chips for /apps — the only JS island on the gallery.
// Single active filter at a time: All / <store> / Free / Paid. The inline
// script reads data-stores + data-paid on each card and toggles [hidden].
import { STORE_FILTERS } from "../../lib/apps";

const chips = [
	{ value: "all", label: "All" },
	...STORE_FILTERS,
	{ value: "free", label: "Free" },
	{ value: "paid", label: "Paid" },
];
---

<div
	data-app-filter
	role="group"
	aria-label="Filter apps"
	class="mb-8 flex flex-wrap justify-center gap-2"
>
	{
		chips.map((chip) => (
			<button
				type="button"
				data-filter={chip.value}
				aria-pressed={chip.value === "all" ? "true" : "false"}
				class="rounded-full border border-border px-3 py-1 text-xs text-text-secondary transition duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] btn-vibrancy aria-pressed:border-flare aria-pressed:bg-flare aria-pressed:text-bg"
			>
				{chip.label}
			</button>
		))
	}
</div>

<script>
	function initAppFilter() {
		const group = document.querySelector<HTMLElement>("[data-app-filter]");
		const grid = document.querySelector<HTMLElement>("[data-apps-grid]");
		if (!group || !grid) return;

		const buttons = Array.from(
			group.querySelectorAll<HTMLButtonElement>("[data-filter]"),
		);
		const cards = Array.from(
			grid.querySelectorAll<HTMLElement>("[data-app-card]"),
		);
		const empty = document.querySelector<HTMLElement>("[data-apps-empty]");

		function matches(card: HTMLElement, filter: string): boolean {
			if (filter === "all") return true;
			if (filter === "free") return card.dataset.paid === "false";
			if (filter === "paid") return card.dataset.paid === "true";
			return (card.dataset.stores ?? "").split(" ").includes(filter);
		}

		function applyFilter(filter: string) {
			let visible = 0;
			for (const card of cards) {
				const show = matches(card, filter);
				card.hidden = !show;
				if (show) visible++;
			}
			if (empty) empty.hidden = visible !== 0;
		}

		for (const btn of buttons) {
			btn.addEventListener("click", () => {
				for (const b of buttons) b.setAttribute("aria-pressed", "false");
				btn.setAttribute("aria-pressed", "true");
				applyFilter(btn.dataset.filter ?? "all");
			});
		}
	}

	initAppFilter();
</script>
