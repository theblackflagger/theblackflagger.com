---
// Chrome for content pages (/apps and app detail). Wraps BaseLayout (shared
// <head>/SEO), imports Tailwind, and uses the shared Header/Footer so every
// page — home included — renders identical chrome from one source.
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
	{/* `app-shell` opts this page into the amber accent chrome — currently the
	    flare focus ring (see tailwind.css). The home page renders the same
	    wrapper markup without this class, so it keeps the monochrome ring. */}
	<div class="app-shell flex min-h-screen flex-col">
		<Header />
		<main class="mx-auto w-full max-w-7xl flex-1 px-5 py-8 sm:px-8">
			<slot />
		</main>
		<Footer />
	</div>
</BaseLayout>
